# Development/test values only. Never copy production credentials into source control.
POSTGRES_PASSWORD=filehoster-dev-password
FILEHOSTER_SECRET_KEY=dev-only-change-me
FILEHOSTER_PUBLIC_BASE_URL=http://localhost:5011
# Production only: bind these ports to the LAN interface, never 0.0.0.0.
# FILEHOSTER_BIND_ADDRESS=127.0.0.1
# FILEHOSTER_PROXY_BIND_ADDRESS=127.0.0.1
# FILEHOSTER_TRUSTED_API_NETWORKS=172.16.0.0/12,10.0.0.0/8
# Production HTTPS overlay (docker-compose-https.yml) only:
# FILEHOSTER_DOMAIN=files.example.com
# ACME_EMAIL=admin@example.com
# FILEHOSTER_PUBLIC_BASE_URL=https://files.example.com
